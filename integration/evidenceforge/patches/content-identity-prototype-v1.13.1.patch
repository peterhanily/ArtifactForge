+def test_generated_scenario_joins_role_specific_zeek_and_sysmon_sha1(tmp_path) -> None:
+    """A real generation run projects one declared identity into both sources."""
+
+    scenario = Scenario.model_validate(_scenario_data())
+    reverse_dns_before = dict(REVERSE_DNS)
+    try:
+        GenerationEngine(scenario, tmp_path).generate()
+    finally:
+        REVERSE_DNS.clear()
+        REVERSE_DNS.update(reverse_dns_before)
+    identity = FileContentIdentity.synthetic(scenario.name, "payload-v1")
+    downloader_identity = FileContentIdentity.synthetic(scenario.name, "downloader-v1")
+
+    files_rows = [
+        json.loads(line)
+        for path in tmp_path.rglob("files.json")
+        for line in path.read_text().splitlines()
+        if line.strip()
+    ]
+    http_rows = [
+        json.loads(line)
+        for path in tmp_path.rglob("http.json")
+        for line in path.read_text().splitlines()
+        if line.strip()
+    ]
+    download_http = [
+        row for row in http_rows if row.get("method") == "GET" and row.get("uri") == "/payload.exe"
+    ]
+    assert len(download_http) == 1
+    response_fuids = set(download_http[0]["resp_fuids"])
+    download_files = [row for row in files_rows if row.get("fuid") in response_fuids]
+    assert len(download_files) == 1
+    assert download_files[0]["sha1"] == identity.digests.sha1
+
+    target_hashes = []
+    for path in tmp_path.rglob("windows_event_sysmon.xml"):
+        xml = re.sub(r"<\?xml[^>]+\?>", "", path.read_text())
+        root = ET.fromstring("<Root>" + xml + "</Root>")
+        for event in (node for node in root.iter() if node.tag.endswith("Event")):
+            fields = {
+                node.attrib.get("Name"): node.text
+                for node in event.iter()
+                if node.tag.endswith("Data")
+            }
+            event_id = next(
+                (node.text for node in event.iter() if node.tag.endswith("EventID")),
+                None,
+            )
+            if event_id == "1" and fields.get("Image") == r"C:\Windows\System32\payload.exe":
+                target_hashes.append(fields["Hashes"])
+    assert len(target_hashes) == 1
+    assert _sha1_from_sysmon_hashes(target_hashes[0]) == identity.digests.sha1
+
+    ground_truth = json.loads((tmp_path / "GROUND_TRUTH.json").read_text())
+    assert ground_truth["schema_version"] == 2
+    response_attributes = [
+        event["attributes"]
+        for event in ground_truth["events"]
+        if "response_content_identity_digests" in event["attributes"]
+    ]
+    assert len(response_attributes) == 1
+    assert response_attributes[0]["response_content_identity_provenance"] == "synthetic_v1"
+    assert response_attributes[0]["response_content_identity_version"] == 1
+    assert response_attributes[0]["response_content_identity_digests"]["sha1"] == (
+        identity.digests.sha1
+    )
+    assert response_attributes[0]["image_content_ref"] == "downloader-v1"
+    assert response_attributes[0]["image_content_identity_digests"]["sha1"] == (
+        downloader_identity.digests.sha1
+    )
+    image_sha1s = {
+        event["attributes"]["image_content_identity_digests"]["sha1"]
+        for event in ground_truth["events"]
+        if "image_content_identity_digests" in event["attributes"]
+    }
+    assert image_sha1s == {identity.digests.sha1, downloader_identity.digests.sha1}
+    manifest = json.loads((tmp_path / "OBSERVATION_MANIFEST.json").read_text())
+    assert manifest["schema_version"] == 2
+    assert manifest["content_identity_model"] == "synthetic_v1"
+    assert manifest["content_identity_version"] == 1
