{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:artifactforge:schema:fixture-manifest:v1",
  "title": "ArtifactForge byte-bound fixture manifest v1",
  "$comment": "Canonical bytes, NFC, duplicate members, ordering, case-fold collisions and all digest equations are enforced by artifactforge.fixture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonicalization",
    "purpose",
    "generator",
    "recipe",
    "recipe_sha256",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "artifactforge-fixture-manifest-v1"
    },
    "canonicalization": {
      "const": "artifactforge-canonical-json-v1"
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "benchmark_eligible"
      ],
      "properties": {
        "kind": {
          "const": "public-reproducible-fixture"
        },
        "benchmark_eligible": {
          "const": false
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "abi"
      ],
      "properties": {
        "name": {
          "const": "artifactforge"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "abi": {
          "const": "artifactforge-fixture-generator-v1"
        }
      }
    },
    "recipe": {
      "$ref": "#/$defs/recipe"
    },
    "recipe_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "canonicalization",
        "file_count",
        "total_bytes",
        "tree_sha256",
        "files"
      ],
      "properties": {
        "root": {
          "const": "artifacts"
        },
        "canonicalization": {
          "const": "artifactforge-fixture-tree-v1"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hostname",
        "username"
      ],
      "properties": {
        "id": {
          "enum": [
            "windows-loose-v1",
            "macos-14-loose-v1"
          ]
        },
        "hostname": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$"
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "purpose",
        "fixture_id",
        "family",
        "profile",
        "seed_hex"
      ],
      "properties": {
        "schema": {
          "const": "artifactforge-fixture-spec-v1"
        },
        "purpose": {
          "const": "public-reproducible-fixture"
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "family": {
          "enum": [
            "windows",
            "macos"
          ]
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "seed_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "windows"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "profile": {
                "properties": {
                  "id": {
                    "const": "windows-loose-v1"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "macos"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "profile": {
                "properties": {
                  "id": {
                    "const": "macos-14-loose-v1"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))(?!.*//)[\\x20-\\x7e]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
