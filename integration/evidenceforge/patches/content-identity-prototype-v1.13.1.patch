+            response_mime_types=request.response_mime_types,
+            timestamp=request.timestamp,
+            content_identity=identity,
+        ),
+        random.Random(4),
+    ).execute()
+
+    assert legacy.file_transfer.sha1
+    assert legacy.file_transfer.sha1 != opted_in.file_transfer.sha1
+    legacy_stable_seed = _stable_seed(
+        "action_bundle:http_file_transfer:"
+        f"{request.host}:{request.uri}:{request.dst_ip}:{request.response_body_len}:"
+        f"{','.join(request.response_mime_types)}:{request.timestamp.isoformat()}:"
+        f"{request.parent_duration or ''}:{request.source}"
+    )
+    assert request.stable_id == f"http-file-transfer-{legacy_stable_seed:016x}"
+
