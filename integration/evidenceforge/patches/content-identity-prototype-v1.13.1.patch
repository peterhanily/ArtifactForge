+"""Canonical synthetic content identity shared across distinct events.
+
+This module deliberately does not claim to materialize file bytes. A scenario's
+role-specific content reference names one logical object, and its digests are
+derived from a domain-separated synthetic seed. The immutable result can be
+reused by transfer and execution occurrences until a future content store can
+replace the seed-derived construction with digests of materialized bytes.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from collections.abc import Collection
+from dataclasses import dataclass
+from typing import Literal
+
+_CONTENT_REF = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,127}")
+
+
+@dataclass(frozen=True, slots=True)
+class FileDigestSet:
+    """Standard whole-file digests; deliberately excludes PE import identity."""
+
+    md5: str
+    sha1: str
+    sha256: str
+
+    def hashes_for(self, analyzers: list[str]) -> dict[str, str]:
+        """Return only standard digest fields for analyzers that actually ran."""
+
+        requested = {analyzer.upper() for analyzer in analyzers}
+        return {
+            algorithm: getattr(self, algorithm)
+            for algorithm in ("md5", "sha1", "sha256")
+            if algorithm.upper() in requested
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class FileContentIdentity:
+    """Immutable scenario-scoped identity for one logical file's content."""
+
+    identity_id: str
+    reference: str
+    digests: FileDigestSet
+    provenance: Literal["synthetic_v1", "materialized_bytes"]
+    derivation_version: int = 1
+
+    @classmethod
+    def synthetic(cls, scenario_name: str, reference: str) -> FileContentIdentity:
+        """Build a domain-separated identity scoped to one scenario and reference."""
+
+        if _CONTENT_REF.fullmatch(reference) is None:
+            raise ValueError(
+                "content_ref must be 1-128 characters and contain only letters, digits, "
+                "dot, underscore, colon, or dash"
+            )
+        seed = f"evidenceforge:file-content:v1:{scenario_name}:{reference}".encode()
+        return cls(
+            identity_id=f"{scenario_name}:{reference}",
+            reference=reference,
+            digests=FileDigestSet(
+                md5=hashlib.md5(seed, usedforsecurity=False).hexdigest(),
+                sha1=hashlib.sha1(seed, usedforsecurity=False).hexdigest(),
+                sha256=hashlib.sha256(seed, usedforsecurity=False).hexdigest(),
+            ),
+            provenance="synthetic_v1",
+        )
+
+
+class FileContentRegistry:
+    """Scenario-owned resolver that constructs each declared identity once."""
+
+    def __init__(self, scenario_name: str, references: Collection[str]) -> None:
+        self.scenario_name = scenario_name
+        self._identities = {
+            reference: FileContentIdentity.synthetic(scenario_name, reference)
+            for reference in references
+        }
+
+    def resolve(self, reference: str) -> FileContentIdentity:
+        """Resolve a declared reference or fail rather than inventing an identity."""
+
+        try:
+            return self._identities[reference]
+        except KeyError as exc:
+            raise ValueError(f"unknown file content reference: {reference}") from exc
