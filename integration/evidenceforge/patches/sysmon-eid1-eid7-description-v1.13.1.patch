+# Copyright (c) 2026 Peter Hanily
+# SPDX-License-Identifier: MIT
+
+"""Regression coverage for Sysmon PE-metadata hash seed consistency."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from evidenceforge.generation.emitters.sysmon import SysmonEventEmitter
+
+
+def test_eid1_and_eid7_hash_seed_includes_description(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Identical rendered metadata produces one hash in both Sysmon call shapes."""
+
+    image = r"C:\Program Files\Example\payload.dll"
+    metadata = (
+        "1.2.3.4",
+        "Example payload module",
+        "Example Product",
+        "Example Company",
+        "payload.dll",
+    )
+    monkeypatch.setattr(
+        SysmonEventEmitter,
+        "_get_pe_metadata",
+        classmethod(lambda cls, image_path, host: metadata),
+    )
+    host = SimpleNamespace(hostname="WS-01")
+
+    eid1 = SysmonEventEmitter._generate_hashes(image, host)
+    eid7 = SysmonEventEmitter._generate_hashes(image, host, rendered_identity=metadata)
+    changed_description = (
+        metadata[0],
+        "Different description",
+        *metadata[2:],
+    )
+
+    assert eid1 == eid7
+    assert eid1 != SysmonEventEmitter._generate_hashes(
+        image,
+        host,
+        rendered_identity=changed_description,
+    )
