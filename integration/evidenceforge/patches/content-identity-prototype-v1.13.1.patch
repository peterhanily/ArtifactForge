+def _sha1_from_sysmon_hashes(value: str) -> str:
+    match = re.search(r"(?:^|,)SHA1=([0-9A-F]+)", value)
+    assert match is not None
+    return match.group(1).lower()
+
+
+def _imphash_from_sysmon_hashes(value: str) -> str:
+    match = re.search(r"(?:^|,)IMPHASH=([0-9A-F]+)", value)
+    assert match is not None
+    return match.group(1)
