{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifactforge-scanner-attestation-v1",
  "title": "ArtifactForge scanner attestation",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "producer",
    "policy",
    "corpus",
    "results",
    "overall_non_proof"
  ],
  "properties": {
    "schema": { "const": "artifactforge-scanner-attestation-v1" },
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "producer": {
      "type": "object",
      "required": ["name", "version", "command", "host"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "const": 1 },
        "command": { "$ref": "#/$defs/command" },
        "host": {
          "type": "object",
          "required": ["platform", "python"],
          "properties": {
            "platform": { "type": "string", "minLength": 1 },
            "python": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["required_scanners", "maximum_age_days", "success_rule"],
      "properties": {
        "required_scanners": {
          "const": ["clamav", "community-yara", "gatekeeper", "xprotect"]
        },
        "maximum_age_days": { "const": 30 },
        "success_rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "corpus": { "$ref": "#/$defs/corpus" },
    "results": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/result" }
    },
    "overall_non_proof": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_file": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": [
        "canonicalization",
        "tree_sha256",
        "file_count",
        "total_bytes",
        "files"
      ],
      "properties": {
        "canonicalization": { "const": "artifactforge-scanner-corpus-v1" },
        "tree_sha256": { "$ref": "#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 1 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/manifest_file" }
        }
      },
      "additionalProperties": false
    },
    "corpus_binding": {
      "type": "object",
      "required": ["canonicalization", "tree_sha256", "file_count", "total_bytes"],
      "properties": {
        "canonicalization": { "const": "artifactforge-scanner-corpus-v1" },
        "tree_sha256": { "$ref": "#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 1 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "required": ["version", "fingerprint_sha256", "manifest"],
      "properties": {
        "version": { "type": ["string", "null"] },
        "fingerprint_sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "manifest": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "type": ["string", "integer", "boolean", "null"] }
    },
    "result": {
      "type": "object",
      "required": [
        "scanner",
        "timestamp",
        "status",
        "corpus_binding",
        "method",
        "control",
        "coverage",
        "exclusions",
        "errors",
        "summary",
        "non_proof"
      ],
      "properties": {
        "scanner": {
          "type": "object",
          "required": ["id", "name", "engine_version", "rules"],
          "properties": {
            "id": {
              "enum": ["clamav", "community-yara", "gatekeeper", "xprotect"]
            },
            "name": { "type": "string", "minLength": 1 },
            "engine_version": { "type": "string", "minLength": 1 },
            "rules": { "$ref": "#/$defs/rules" }
          },
          "additionalProperties": false
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "enum": ["clean", "finding", "observation", "error"] },
        "corpus_binding": { "$ref": "#/$defs/corpus_binding" },
        "method": {
          "type": "object",
          "required": ["command", "description"],
          "properties": {
            "command": { "$ref": "#/$defs/command" },
            "description": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "control": {
          "type": "object",
          "required": [
            "kind",
            "scope",
            "status",
            "command",
            "input_sha256",
            "input_digest_method",
            "expected",
            "observed",
            "demonstrates"
          ],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "scope": {
              "enum": ["engine-only", "engine-and-selected-rules", "engine-and-host-policy"]
            },
            "status": { "enum": ["passed", "failed"] },
            "command": { "$ref": "#/$defs/command" },
            "input_sha256": { "$ref": "#/$defs/sha256" },
            "input_digest_method": { "type": "string", "minLength": 1 },
            "near_miss_sha256": { "$ref": "#/$defs/sha256" },
            "expected": { "type": "string", "minLength": 1 },
            "observed": { "type": "string", "minLength": 1 },
            "demonstrates": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "coverage": { "type": "object", "minProperties": 4 },
        "exclusions": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "summary": { "type": "object", "minProperties": 3 },
        "non_proof": {
          "type": "object",
          "required": ["boundary_id", "statement"],
          "properties": {
            "boundary_id": { "type": "string", "minLength": 1 },
            "statement": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
