+            response_body_len=8_000_000,
+            response_mime_types=["application/x-msdownload"],
+            timestamp=datetime(2026, 8, 1, 12, 0, tzinfo=UTC),
+            content_identity=identity,
+        ),
+        random.Random(4),
+    ).execute()
+    process = ProcessContext(
+        pid=4100,
+        parent_pid=4000,
+        image=r"C:\Users\analyst\Downloads\payload.exe",
+        command_line="payload.exe",
+        username="analyst",
+        image_content_identity=identity,
+    )
+    execution = SecurityEvent(
+        timestamp=datetime(2026, 8, 1, 12, 1, tzinfo=UTC),
+        event_type="process_create",
+        process=process,
+    )
+    sysmon_hashes = SysmonEventEmitter._process_hashes_for_event(
+        execution,
+        process.image,
+    )
+    legacy_hashes = SysmonEventEmitter._generate_hashes(process.image)
+
+    assert transfer.file_transfer.content_identity is identity
+    assert transfer.file_transfer.analyzers == ["SHA1"]
+    assert transfer.file_transfer.sha1 == identity.digests.sha1
+    assert _sha1_from_sysmon_hashes(sysmon_hashes) == identity.digests.sha1
+    assert _imphash_from_sysmon_hashes(sysmon_hashes) == _imphash_from_sysmon_hashes(
+        legacy_hashes
