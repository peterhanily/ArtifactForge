# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
build/
dist/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store

# ArtifactForge generated output
out/
ef-out/
.content-cache/

# Benchmark suite keys. A hold-out suite's key is what makes its scores real; committing one
# silently converts every score it ever produced back into a dev-suite score.
**/_key/
*.key.hex

# samples/ holds committed artifacts, and nothing above matches them — so there are no
# negations here on purpose. A blanket `!samples/**` would re-enable EVERY ignored pattern
# inside the one directory where a real artifact could be staged by mistake, which is the
# opposite of what it looks like it does. These are deny rules only, and deny rules win.
samples/**/real*
samples/**/.DS_Store
samples/**/*.env
samples/**/.env
samples/**/*.key
samples/**/*.pem
samples/**/*.p12
