{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:artifactforge:schema:fixture-spec:v2",
  "title": "ArtifactForge public reproducible fixture recipe v2",
  "$comment": "This is a structural companion to the authoritative Python model. Canonical bytes, duplicate-member rejection, NFC, and equality of causal_clock to the seed-plus-context derivation are enforced by artifactforge.fixture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "purpose",
    "fixture_id",
    "family",
    "profile",
    "seed_hex",
    "causal_clock"
  ],
  "properties": {
    "schema": {
      "const": "artifactforge-fixture-spec-v2"
    },
    "purpose": {
      "const": "public-reproducible-fixture"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "family": {
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "seed_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "causal_clock": {
      "$ref": "#/$defs/causal_clock"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "const": "windows"
          }
        },
        "required": [
          "family"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "properties": {
              "id": {
                "const": "windows-loose-v2"
              },
              "username": {
                "$ref": "#/$defs/windows_username"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "macos"
          }
        },
        "required": [
          "family"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "properties": {
              "id": {
                "const": "macos-14-loose-v2"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "linux"
          }
        },
        "required": [
          "family"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "properties": {
              "id": {
                "const": "linux-glibc-x86_64-loose-v2"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hostname",
        "username"
      ],
      "properties": {
        "id": {
          "enum": [
            "windows-loose-v2",
            "macos-14-loose-v2",
            "linux-glibc-x86_64-loose-v2"
          ]
        },
        "hostname": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$"
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      }
    },
    "causal_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "anchor_unix_ns"
      ],
      "properties": {
        "profile": {
          "const": "artifactforge-causal-clock-v1"
        },
        "anchor_unix_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "multipleOf": 1000000000
        }
      }
    },
    "windows_username": {
      "type": "string",
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\..*)?$)(?!.*[.]$)[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "$comment": "Matches the model's reserved DOS device-name and trailing-dot restrictions for a single Windows path component."
    }
  }
}
